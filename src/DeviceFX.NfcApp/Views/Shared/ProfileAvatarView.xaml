<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Name="This"
             x:Class="DeviceFX.NfcApp.Views.Shared.ProfileAvatarView">
    <ContentView.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentView.Resources>
    <Grid WidthRequest="{Binding Size, Source={x:Reference This}}"
          HeightRequest="{Binding Size, Source={x:Reference This}}">
        <Image Source="grey_settings_gear.png"
               Aspect="AspectFit"
               IsVisible="{Binding IsLoggedIn, Converter={StaticResource InvertedBoolConverter}}" />
        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 999,999,999,999"
                BackgroundColor="{Binding CircleColor, Source={x:Reference This}}"
                IsVisible="{Binding IsLoggedIn}">
            <Grid>
                <Label Text="{Binding Initials}"
                       TextColor="{Binding InitialsColor, Source={x:Reference This}}"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontSize="{Binding InitialsFontSize, Source={x:Reference This}}" />
                <ffimageloading:CachedImage Source="{Binding Picture}"
                                            Aspect="AspectFill"
                                            CacheType="All" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
